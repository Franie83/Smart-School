SECRET_KEY=replace-with-a-long-random-secret
DATABASE_PATH=instance/smart_school.sqlite3
HOST=127.0.0.1
PORT=5000
CORS_ORIGINS=http://localhost:3000
# Optional initial administrator; otherwise the first-run screen creates the first super admin
# If setting these, use unique credentials and set both before the first launch
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=use-a-long-unique-password
# BOOTSTRAP_ADMIN_NAME=System Administrator
# Required only for protected legacy data import
MIGRATION_TOKEN=replace-with-a-separate-long-token
